@echo off
rem Букет для тебя. Окно ~1920x1080: шрифт Consolas 13px, 274x80 символов
if not "%~1"=="run" (
  reg add "HKCU\Console\Buket" /v FaceName /t REG_SZ /d "Consolas" /f >nul
  reg add "HKCU\Console\Buket" /v FontSize /t REG_DWORD /d 0x000d0000 /f >nul
  reg add "HKCU\Console\Buket" /v FontFamily /t REG_DWORD /d 0x36 /f >nul
  reg add "HKCU\Console\Buket" /v WindowPosition /t REG_DWORD /d 0 /f >nul
  start "Buket" conhost.exe cmd /c ""%~f0" run"
  exit /b
)
reg delete "HKCU\Console\Buket" /f >nul 2>nul
chcp 65001 >nul
title Букет для тебя
mode con cols=274 lines=80
